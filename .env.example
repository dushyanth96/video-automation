# --- LLM (NVIDIA NIM, OpenAI-compatible, FREE) ---
# Get at https://build.nvidia.com -> any model -> Get API Key
NVIDIA_NIM_API_KEY=nvapi-paste-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_IDEATE_MODEL=openai/gpt-oss-20b
NVIDIA_SCRIPT_MODEL=openai/gpt-oss-20b
# Magpie TTS voices for Leo & Alex (used with --tts nvidia). List: see README 2.1.
NVIDIA_TTS_VOICE_LEO=Magpie-Multilingual.EN-US.Jason.Happy
NVIDIA_TTS_VOICE_ALEX=Magpie-Multilingual.EN-US.Jason
# Per-speaker pace (1.0 = natural, higher = snappier) and pitch (>1.0 = cartoonish). Tune to taste.
NVIDIA_TTS_TEMPO_LEO=1.05
NVIDIA_TTS_TEMPO_ALEX=1.12
NVIDIA_TTS_PITCH_LEO=1.0
NVIDIA_TTS_PITCH_ALEX=1.0

# --- News (optional) ---
# Get at https://tavily.com (free 1000/mo). Leave empty to use RSS only.
TAVILY_API_KEY=

# --- Telegram (you already have this) ---
# @BotFather -> /newbot gives token. Send bot a Hi, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates to find chat id.
TELEGRAM_BOT_TOKEN=paste-here
TELEGRAM_CHAT_ID=paste-here

# --- Cloudflare R2 (video storage + public watch URLs) ---
# Dashboard -> R2 Object Storage -> Create bucket -> Manage R2 API tokens.
R2_ACCOUNT_ID=paste-here
R2_ACCESS_KEY_ID=paste-here
R2_SECRET_ACCESS_KEY=paste-here
R2_BUCKET=videos-automation
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://videos.yourdomain.com

# --- GitHub (Worker triggers Actions; also add these as Actions Secrets) ---
GH_REPO_OWNER=paste-here
GH_REPO_NAME=video-automation
GH_PAT=github_pat_paste-here

# --- YouTube Shorts ---
# console.cloud.google.com -> enable YouTube Data API v3 -> OAuth Desktop client.
YT_CLIENT_ID=paste-here.apps.googleusercontent.com
YT_CLIENT_SECRET=paste-here
# Run: python pipeline/get_yt_token.py  then paste output below:
YT_REFRESH_TOKEN=

# --- Instagram Reels via Meta Graph ---
# developers.facebook.com -> App -> IG Graph -> link FB Page + IG Business.
META_APP_ID=
META_APP_SECRET=
FB_PAGE_ID=
IG_BUSINESS_ID=
META_LONG_LIVED_TOKEN=

# --- App ---
TIMEZONE=Asia/Kolkata
APPROVAL_HOLD_DAYS=7
